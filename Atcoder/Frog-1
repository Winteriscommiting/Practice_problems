N = int(input())
h = [int(x) for x in input().split()]
if N == 2:
    print(abs(h[1] - h[0]))
    exit()
dp = [0] * N
dp[0] = 0
dp[1] = abs(h[1] - h[0])
for i in range(2, N):
    jump_one = dp[i - 1] + abs(h[i] - h[i - 1])
    jump_two = dp[i - 2] + abs(h[i] - h[i - 2])
    dp[i] = min(jump_one, jump_two)
print(dp[N - 1])

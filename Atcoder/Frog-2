input_data = input().split()
N = int(input_data[0])
K = int(input_data[1])
h = [int(x) for x in input().split()]
if N == 2:
    print(abs(h[1] - h[0]))
    exit()
dp = [float('inf')] * N
dp[0] = 0
for i in range(1, N):
    for j in range(1, K + 1):
        if i - j >= 0:
            cost = dp[i - j] + abs(h[i] - h[i - j])
            dp[i] = min(dp[i], cost)
        else:
            break
print(dp[N - 1])
